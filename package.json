{
  "name": "wp-plugin-oyiso",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "i18n:extract": "php scripts/update-oyiso-pot.php",
    "i18n:sync": "php scripts/update-oyiso-pot.php --sync",
    "i18n:prune": "php scripts/update-oyiso-pot.php --prune",
    "i18n:check": "php scripts/update-oyiso-pot.php --check --strict",
    "i18n:build": "node scripts/build-i18n.js",
    "test:agent-ui": "node --test tests/ai-agent/agent-ui.test.cjs tests/ai-agent/page-context.test.cjs tests/ai-agent/live-ui.test.cjs tests/ai-agent/model-settings.test.cjs tests/ai-agent/files-ui.test.cjs tests/ai-agent/mcp-settings.test.cjs",
    "test:checkout-maintenance": "node --test tests/checkout-maintenance/*.test.cjs",
    "test:checkout-maintenance:php": "php tests/checkout-maintenance/checkout-maintenance.test.php",
    "test:backup": "node --test tests/backup/*.test.cjs"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "gettext-parser": "^9.0.2",
    "jsdom": "^30.1.3",
    "markdown-it": "15.0.3"
  },
  "overrides": {
    "glob@>=10.2.0 <10.5.0": "^10.5.0",
    "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7"
  }
}
