parameters:
    level: 9
    # WordPress option reads/writes can change after SQL and cache updates.
    rememberPossiblyImpureFunctionValues: false
    paths:
        - ../../src/ai-agent/query.php
        - ../../src/ai-agent/query-source.php
        - ../../src/ai-agent/query-filter.php
        - ../../src/ai-agent/query-spec.php
        - ../../src/ai-agent/query-catalog.php
        - ../../src/ai-agent/abilities.php
        - ../../src/ai-agent/tool-feedback.php
        - ../../src/ai-agent/order-update.php
        - ../../src/ai-agent/tools.php
        - ../../src/ai-agent/model.php
        - ../../src/ai-agent/completion.php
        - ../../src/ai-agent/compaction.php
        - ../../src/ai-agent/mcp.php
        - ../../src/ai-agent/messages.php
        - ../../src/ai-agent/store.php
        - ../../src/ai-agent/runner.php
        - ../../src/ai-agent/admin.php
        - ../../src/ai-agent/live.php
    scanDirectories:
        - ../../src/ai-agent
        - ../../../woocommerce/includes
        - ../../../woocommerce/src
        - ../../../../../wp-includes/ai-client
        - ../../../../../wp-includes/php-ai-client/src
        - ../../../../../wp-includes/abilities-api
    scanFiles:
        - ../../src/admin/config-collapse.php
        - ../../vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - ../../../../../wp-includes/ai-client.php
        - ../../../../../wp-includes/abilities.php
        - ../../../../../wp-includes/abilities-api.php
